{
  "name": "smartpages-web",
  "private": true,
  "workspaces": ["blog", "app"],
  "scripts": {
    "build": "npm run build:blog && npm run build:app",
    "build:blog": "cd blog && npm run build -- --outDir=../dist --emptyOutDir",
    "build:app": "cd app && npm run build -- --base=/app/ --outDir=../dist/app --emptyOutDir",
    "dev:blog": "cd blog && npm run dev",
    "dev:app": "cd app && npm run dev"
  }
}